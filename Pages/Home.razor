@page "/"
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Random Team Generator</PageTitle>

<header class="app-header">
    <h1>🎲 Random Team Generator</h1>
    <p class="app-subtitle">Enter players and scores, then click Randomize to build teams.</p>
</header>

<div class="controls-bar">
    <div class="team-size-group">
        <span class="bar-label">Team Size:</span>
        <input type="number" class="team-size-input"
               value="@_teamSize"
               @onchange="@(e => { if (int.TryParse(e.Value?.ToString(), out var v) && v >= 1) _teamSize = v; })"
               min="1" max="50" />
    </div>
    <button class="btn-randomize" @onclick="Randomize">🎲 Randomize!</button>
    <button class="btn-clear" @onclick="ClearAll">🗑 Clear All</button>
    <div class="click-counter">
        Randomized <span class="counter-num">@_clickCount</span> times this session
    </div>
</div>

<div class="groupme-bar">
    <span class="bar-label">GroupMe Bot ID:</span>
    <input type="text" class="bot-id-input"
           value="@_botId"
           @oninput="@(e => _botId = e.Value?.ToString() ?? "")"
           placeholder="Paste your Bot ID here" />
    <label class="auto-post-label">
        <input type="checkbox" checked="@_autoPost" @onchange="OnAutoPostChanged" />
        Auto-post when randomizing
    </label>
    <span class="gm-hint">Create a bot at dev.groupme.com</span>
</div>

<main>
    <section class="results-section">
        <h2 class="section-title">Results</h2>

        @if (_results.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">🎲</div>
                <div class="empty-title">No results yet</div>
                <div class="empty-sub">Add your players below and click Randomize!</div>
            </div>
        }

        @* Newest result is inserted at index 0, so index 0 gets the blue border *@
        @for (int r = 0; r < _results.Count; r++)
        {
            var result = _results[r];
            <div class="result-card @(r == 0 ? "result-latest" : "")" @key="result.Iteration">
                <div class="result-header">
                    <span class="result-title">Randomization #@result.Iteration</span>
                    <div class="result-header-right">
                        <span class="result-time">@result.Time</span>
                        <button class="btn-groupme" @onclick="@(() => SendToGroupMe(result))">📤 GroupMe</button>
                    </div>
                </div>

                @if (result.HasFillIns)
                {
                    <div class="warning-banner">
                        <div class="warning-bar"></div>
                        <div class="warning-text">⚠️ @result.FillInNotice</div>
                    </div>
                }

                <div class="teams-grid">
                    @foreach (var team in result.Teams)
                    {
                        <div class="team-card @team.PlaceClass">
                            <div class="team-header">
                                <span class="place-label @team.HeadingClass">
                                    @if (team.FlankEmoji.Length > 0)
                                    {
                                        <span class="place-emoji">@team.FlankEmoji</span>
                                    }
                                    <span class="place-text">@team.PlaceLabel</span>
                                    @if (team.FlankEmoji.Length > 0)
                                    {
                                        <span class="place-emoji">@team.FlankEmoji</span>
                                    }
                                </span>
                            </div>
                            <div class="team-players">
                                @foreach (var p in team.Players)
                                {
                                    <div class="player-line">
                                        <span class="pl-name">@p.Name</span>
                                        <span class="pl-score">@FormatScore(p.Score)</span>
                                    </div>
                                }
                            </div>
                            <div class="team-total">
                                <span class="total-label">Team Total:</span>
                                <span class="total-value">@FormatScore(team.Total)</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </section>

    <section class="player-sheet">
        <div class="sheet-heading">
            <h2 class="section-title">Player Entry Sheet</h2>
            <span class="player-count">@_players.Count player@(_players.Count == 1 ? "" : "s")</span>
        </div>

        <div class="col-headers">
            <span class="col-num">#</span>
            <span class="col-name">PLAYER NAME</span>
            <span class="col-score">SCORE</span>
            <span></span>
        </div>

        <div class="player-list" id="playerList">
            @for (int i = 0; i < _players.Count; i++)
            {
                var player = _players[i];
                var rowNum = i + 1;
                <div class="player-row" @key="player.Id">
                    <span class="row-num">@rowNum</span>
                    <input type="text" class="name-input"
                           value="@player.Name"
                           @oninput="@(e => player.Name = e.Value?.ToString() ?? "")"
                           placeholder="Player name"
                           data-player-id="@player.Id" />
                    <input type="text" class="score-input"
                           value="@player.ScoreText"
                           @oninput="@(e => player.ScoreText = e.Value?.ToString() ?? "0")"
                           inputmode="decimal"
                           placeholder="0" />
                    <button class="btn-remove" @onclick="@(() => RemovePlayer(player.Id))" tabindex="-1">✕</button>
                </div>
            }
        </div>

        <div class="sheet-footer">
            <button class="btn-add" @onclick="AddPlayer">+ Add Player</button>
        </div>
    </section>
</main>

@code {
    private class PlayerEntry
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string ScoreText { get; set; } = "0";
        public double Score => double.TryParse(ScoreText, out var s) ? s : 0;
    }

    private class PlayerSnapshot
    {
        public string Name { get; set; } = "";
        public double Score { get; set; }
    }

    private class TeamResult
    {
        public int Number { get; set; }
        public List<PlayerSnapshot> Players { get; set; } = new();
        public double Total { get; set; }
        public int Place { get; set; }
        public bool IsTie { get; set; }
        public bool IsWinner => Place == 1;

        /// <summary>Outright last, not tied for it.</summary>
        public bool IsLast { get; set; }

        // 1st blue, 2nd red, 3rd white, everything past that dim and faded
        public string PlaceClass => Place is >= 1 and <= 3 ? $"place-{Place}" : "place-faded";

        /// <summary>
        /// "Winner" for an outright win and "Loser" for outright last,
        /// otherwise "Tie 1st Place" / "2nd Place" / …
        /// </summary>
        public string PlaceLabel =>
            IsTie ? $"Tie {Ordinal(Place)} Place"
            : IsWinner ? "Winner"
            : IsLast ? "Loser"
            : $"{Ordinal(Place)} Place";

        /// <summary>
        /// Mirrored on both sides of the label. Kept as separate elements from
        /// the text so the crying faces can be scaled up on their own.
        /// </summary>
        public string FlankEmoji => IsWinner ? "🏆" : IsLast ? "😭😭" : "";

        /// <summary>
        /// Extra header styling: the outright winner's color strobes, the
        /// outright loser sits in static gold — darkened on the near-white
        /// 3rd-place card so it stays legible.
        /// </summary>
        public string HeadingClass =>
            IsWinner && !IsTie ? "strobe-winner"
            : IsLast ? (Place == 3 ? "loser-gold-dark" : "loser-gold")
            : "";

        private static string Ordinal(int n)
        {
            if (n % 100 is >= 11 and <= 13) return $"{n}th";
            return (n % 10) switch
            {
                1 => $"{n}st",
                2 => $"{n}nd",
                3 => $"{n}rd",
                _ => $"{n}th"
            };
        }
    }

    private class RandomizationResult
    {
        public int Iteration { get; set; }
        public string Time { get; set; } = "";
        public List<TeamResult> Teams { get; set; } = new();
        public int PlayerCount { get; set; }
        public int TeamSize { get; set; }

        /// <summary>Players given a second entry to even out the teams.</summary>
        public List<string> FillInNames { get; set; } = new();

        public bool HasFillIns => FillInNames.Count > 0;

        public string FillInNotice => !HasFillIns
            ? ""
            : $"{PlayerCount} players don't split evenly into teams of {TeamSize} — "
              + $"{NameList(FillInNames)} {(FillInNames.Count == 1 ? "has" : "have")} "
              + "the lowest score and played twice to even things out. Missing a player?";

        private static string NameList(List<string> names) => names.Count switch
        {
            1 => names[0],
            2 => $"{names[0]} and {names[1]}",
            _ => string.Join(", ", names.Take(names.Count - 1)) + $" and {names[^1]}"
        };
    }

    private List<PlayerEntry> _players = new();
    private List<RandomizationResult> _results = new();
    private int _clickCount;
    private int _nextId = 1;
    private int _teamSize = 2;
    private string _botId = "";
    private bool _autoPost;

    protected override void OnInitialized()
    {
        for (int i = 1; i <= 6; i++)
            _players.Add(new PlayerEntry { Id = _nextId++, Name = $"Player{i}", ScoreText = "0" });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _botId = await JS.InvokeAsync<string?>("localStorage.getItem", "rs_botid") ?? "";
        var ap = await JS.InvokeAsync<string?>("localStorage.getItem", "rs_autopost");
        _autoPost = ap == "1";
        StateHasChanged();
    }

    private async Task SaveSettings()
    {
        await JS.InvokeVoidAsync("localStorage.setItem", "rs_botid", _botId);
        await JS.InvokeVoidAsync("localStorage.setItem", "rs_autopost", _autoPost ? "1" : "0");
    }

    private async Task OnAutoPostChanged(ChangeEventArgs e)
    {
        _autoPost = e.Value is bool b && b;
        await SaveSettings();
    }

    private void AddPlayer()
    {
        // Roster change makes the results on screen stale
        _results.Clear();
        _players.Add(new PlayerEntry { Id = _nextId++, Name = "", ScoreText = "0" });
    }

    private void RemovePlayer(int id)
    {
        _players.RemoveAll(p => p.Id == id);
    }

    private async Task Randomize()
    {
        var active = _players.Where(p => !string.IsNullOrWhiteSpace(p.Name)).ToList();
        if (active.Count < 2)
        {
            await JS.InvokeVoidAsync("alert", "Please add at least 2 players with names.");
            return;
        }

        _clickCount++;

        var rng = new Random();

        // An odd player count can't fill teams of N, so the lowest
        // individual scorer(s) get a second entry and play on two teams.
        var fillIns = PickFillIns(active, _teamSize, rng);
        var entries = active.Concat(fillIns).ToList();
        var shuffled = ShuffleAcrossTeams(entries, _teamSize, rng);

        var teams = new List<TeamResult>();
        for (int i = 0; i < shuffled.Count; i += _teamSize)
        {
            var chunk = shuffled.Skip(i).Take(_teamSize)
                .Select(p => new PlayerSnapshot { Name = p.Name, Score = p.Score })
                .ToList();
            teams.Add(new TeamResult
            {
                Number = teams.Count + 1,
                Players = chunk,
                Total = chunk.Sum(p => p.Score)
            });
        }

        // Best (lowest) total finishes first, so results read top-down by place
        teams = teams.OrderBy(t => t.Total).ToList();
        AssignPlaces(teams);

        var result = new RandomizationResult
        {
            Iteration = _clickCount,
            Time = DateTime.Now.ToString("h:mm:ss tt"),
            Teams = teams,
            PlayerCount = active.Count,
            TeamSize = _teamSize,
            FillInNames = fillIns.Select(p => p.Name).ToList()
        };

        _results.Insert(0, result);

        if (_autoPost && !string.IsNullOrWhiteSpace(_botId))
        {
            await SaveSettings();
            await PostToGroupMe(result, showSuccess: false);
        }
    }

    /// <summary>
    /// Extra entries needed to make the player count divide evenly by team
    /// size, taken lowest individual score first with ties broken randomly.
    /// Empty when the teams already come out even.
    /// </summary>
    private static List<PlayerEntry> PickFillIns(List<PlayerEntry> players, int teamSize, Random rng)
    {
        int remainder = players.Count % teamSize;
        if (remainder == 0) return new List<PlayerEntry>();

        var lowestFirst = players
            .Select(p => new { Player = p, Tiebreak = rng.Next() })
            .OrderBy(x => x.Player.Score)
            .ThenBy(x => x.Tiebreak)
            .Select(x => x.Player)
            .ToList();

        // Wraps if one short player list has to cover several open slots
        return Enumerable.Range(0, teamSize - remainder)
            .Select(i => lowestFirst[i % lowestFirst.Count])
            .ToList();
    }

    /// <summary>
    /// Fisher-Yates shuffle, retried so a player holding two entries lands
    /// on two different teams rather than being paired with themselves.
    /// Bounded, since some splits make that impossible.
    /// </summary>
    private static List<PlayerEntry> ShuffleAcrossTeams(List<PlayerEntry> entries, int teamSize, Random rng)
    {
        var shuffled = entries.ToList();

        for (int attempt = 0; attempt < 200; attempt++)
        {
            for (int i = shuffled.Count - 1; i > 0; i--)
            {
                int j = rng.Next(i + 1);
                (shuffled[i], shuffled[j]) = (shuffled[j], shuffled[i]);
            }

            if (!HasRepeatWithinTeam(shuffled, teamSize)) break;
        }

        return shuffled;
    }

    private static bool HasRepeatWithinTeam(List<PlayerEntry> entries, int teamSize)
    {
        for (int i = 0; i < entries.Count; i += teamSize)
        {
            var team = entries.Skip(i).Take(teamSize).ToList();
            if (team.Distinct().Count() != team.Count) return true;
        }

        return false;
    }

    /// <summary>
    /// Stamps each team with its finishing place using standard competition
    /// ranking, so a two-way tie for 1st is followed by 3rd. Expects
    /// <paramref name="teams"/> already sorted best-score-first.
    /// </summary>
    private static void AssignPlaces(List<TeamResult> teams)
    {
        int place = 1;
        for (int i = 0; i < teams.Count; i++)
        {
            // Tolerance so decimal scores that sum with float drift still tie
            if (i > 0 && Math.Abs(teams[i].Total - teams[i - 1].Total) > 1e-9)
                place = i + 1;
            teams[i].Place = place;
        }

        foreach (var team in teams)
            team.IsTie = teams.Count(t => t.Place == team.Place) > 1;

        // Dead last on its own earns the "Loser" tag; a tie for last doesn't
        int lastPlace = teams[^1].Place;
        foreach (var team in teams)
            team.IsLast = teams.Count > 1 && team.Place == lastPlace && !team.IsTie;
    }

    private async Task ClearAll()
    {
        var ok = await JS.InvokeAsync<bool>("confirm", "Clear all results and reset the player list to defaults?");
        if (!ok) return;

        _results.Clear();
        _clickCount = 0;
        _players.Clear();
        _nextId = 1;

        for (int i = 1; i <= 6; i++)
            _players.Add(new PlayerEntry { Id = _nextId++, Name = $"Player{i}", ScoreText = "0" });
    }

    private async Task SendToGroupMe(RandomizationResult result)
    {
        if (string.IsNullOrWhiteSpace(_botId))
        {
            await JS.InvokeVoidAsync("alert", "Enter a GroupMe Bot ID in the bar at the top.");
            return;
        }
        await SaveSettings();
        await PostToGroupMe(result, showSuccess: true);
    }

    private async Task PostToGroupMe(RandomizationResult result, bool showSuccess)
    {
        try
        {
            var response = await Http.PostAsJsonAsync(
                "https://api.groupme.com/v3/bots/post",
                new { bot_id = _botId, text = FormatGroupMeMessage(result) });

            if (response.IsSuccessStatusCode)
            {
                if (showSuccess)
                    await JS.InvokeVoidAsync("alert", "Results sent to GroupMe!");
            }
            else
            {
                await JS.InvokeVoidAsync("alert",
                    $"GroupMe returned {(int)response.StatusCode}. Double-check your Bot ID.");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Could not reach GroupMe:\n{ex.Message}");
        }
    }

    private string FormatGroupMeMessage(RandomizationResult result)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"🎲 Random Teams #{result.Iteration} | {result.Time}");
        if (result.HasFillIns) sb.AppendLine($"⚠️ {result.FillInNotice}");
        sb.AppendLine();
        foreach (var team in result.Teams)
        {
            string prefix = team.IsWinner ? "🏆 " : team.IsLast ? "😭 " : "";
            string suffix = team.IsWinner && !team.IsTie ? " — WINNER!"
                : team.IsLast ? " — LOSER!"
                : $" — {team.PlaceLabel}";
            sb.AppendLine($"{prefix}Team {team.Number}: {FormatScore(team.Total)} pts{suffix}");
            sb.AppendLine("  " + string.Join(", ", team.Players.Select(p => $"{p.Name} ({FormatScore(p.Score)})")));
            sb.AppendLine();
        }
        return sb.ToString().Trim();
    }

    private static string FormatScore(double score) =>
        score % 1 == 0 ? score.ToString("0") : score.ToString("0.##");
}
